# Local development / a single Node host: leave both unset.
# For a separate frontend (Vercel), set this in Vercel BEFORE building:
# VITE_SERVER_URL=https://YOUR-ACTUAL-BACKEND.onrender.com

# On the persistent Node backend, permit the frontend origin:
# APP_ORIGIN=https://plot-maker.vercel.app
# Multiple exact frontend origins can be separated by commas.
# Do not put secrets in any VITE_ variable; these are public browser settings.
